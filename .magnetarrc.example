# .magnetarrc — Magnetar 模型部署工作流项目配置
# 复制为 .magnetarrc 并按需修改。
# Codex 会在启动时读取此文件，已配置的项不再重复提问。

# 多任务并发时：本文件只放公共默认（凭据/工具链/行为选项），任务参数
# （SOURCE/TARGET_HARDWARE/MODEL_NAME/BOARD/TASK_DIR）在 INIT 阶段固化到
# 各 TASK_DIR/config.json，后续阶段读 config.json（load_task_config），
# 不要为了新任务反复修改本文件，避免并发任务互相覆盖。

# ===== 必需参数 =====

# 模型来源: Git 仓库 | HuggingFace repo | 本地目录 | 单文件路径 | 可下载 URL
SOURCE=

# 目标芯片: AX650 | AX620E
TARGET_HARDWARE=AX650

# ===== 板端验证（可选）=====
# 留空则跳过 RUNONBOARD 阶段

# 板端 SSH 信息，格式 user@host[:port]
BOARD=

# 板端密码（默认 123456）
BOARD_PASSWORD=123456

# 扫端口发现板子（可选，环境变量 MAGNETAR_SCAN_SUBNET）：dashboard 不可用/无空闲板时，
# select_board 回退扫描该网段 18500 端口（默认取 dashboard 所在 /24）
# MAGNETAR_SCAN_SUBNET=10.126.35.0/24

# ===== 可选参数 =====

# 模型名称（留空则从 SOURCE 自动推断）
MODEL_NAME=

# 任务工作目录（留空则自动生成 todos/work/<timestamp>-<model>/）
# 也可通过环境变量 MAGNETAR_TASK_DIR 全局覆盖
TASK_DIR=

# SDK 语言: python | cpp | both
SDK_LANG=both

# ===== Pulsar2 编译环境 =====

# Pulsar2 执行后端：官方独立安装包（默认，推荐）| docker（兜底）。
# 独立包用 scripts/install_pulsar2.sh 安装（PULSAR2_MODE=package），
# 或手动解压 ax_pulsar2_*_package.tar.gz 后用 PULSAR2_HOME 指定目录。
# 未设置 PULSAR2_HOME 时自动扫描 ~/.cache/magnetar/pulsar2/<版本>/，
# 找不到再回退 Docker 镜像。
PULSAR2_HOME=

# 独立包下载变体: lite（无 GPU，默认）| full（含 GPU 依赖）
# PULSAR2_PACKAGE=lite

# Pulsar2 Docker 镜像（PULSAR2_HOME 未命中时才使用；留空自动从默认路径获取）
# PULSAR2_IMAGE=

# 共享 base 转换环境（torch/onnxruntime/transformers 等大包只装一次）。
# 留空默认 ~/.cache/magnetar/base-venv；任务薄 venv 经 .pth 链接复用
# MAGNETAR_BASE_VENV=

# BSP 公共目录（AX650 BSP SDK 自动下载到这里，含 include/lib + 交叉编译器）。
# 留空默认 ~/.cache/magnetar/bsp
# MAGNETAR_BSP_HOME=

# BSP 下载地址（AX650 默认 ModelScope AX650-Community-Hub；AX620E 必须显式给）
# CXX_BSP_URL=

# aarch64 交叉编译器下载地址（AX650 默认 Arm GNU 9.2 官方地址）
# CXX_TOOLCHAIN_URL=

# ===== LLM / 自回归模型（ax-llm 路由，可选）=====
# 模型被判定为自回归/类 LLM 时自动走 ax-llm 路径（pulsar2 llm_build2 + axllm），
# 以下参数仅在需要覆盖默认值时设置：

# ax-llm 仓库与分支（板端 axllm 安装源）
# AX_LLM_REPO=https://github.com/AXERA-TECH/ax-llm.git
# AX_LLM_BRANCH=axllm

# ax-llm-build 仓库（embedding 处理工具）
# AX_LLM_BUILD_REPO=https://github.com/AXERA-TECH/ax-llm-build.git

# llm_build2 参数
# LLM_MAX_CONTEXT=1024      # decode 最大 attention 长度
# LLM_PREFILL_LEN=0         # prefill 总 token 长度
# LLM_PREFILL_STEP_SIZE=    # 每个 prefill 子图 token 数（如 128）
# LLM_WEIGHT_TYPE=s8        # s8 | s4 | bf16 | fp16 | fp32（大模型可试 s4）
# LLM_HIDDEN_STATE_TYPE=bf16  # bf16 | fp16 | fp32

# ===== C++ BSP / 交叉编译器 =====

# AX650 BSP SDK 下载地址（留空使用默认）
# CXX_BSP_URL=

# AX620E 交叉编译器下载地址（留空使用默认）
# CXX_BSP_URL=

# ===== HuggingFace 凭据 =====

# 私有模型访问令牌（留空则从环境变量 HF_TOKEN 读取）
# HF_TOKEN=

# ===== PUBLISH 发布凭据 =====

# GitHub 个人访问令牌（留空则从环境变量 GITHUB_TOKEN 读取）
# GITHUB_TOKEN=

# GitHub 组织名（可选，默认推送到个人账户）
# GITHUB_ORG=

# HuggingFace 命名空间（可选，默认推送到个人账户）
# HF_ORG=

# ===== 国内镜像（默认值，海外用户可置空字符串恢复直连）=====

# 涉及 HuggingFace 的内容（权重 / Pulsar2 / BSP SDK 等）先查 ModelScope：
#   magnetar.net_util.modelscope_available("<org>/<name>")，有则优先 ModelScope，无才回退 HF
# HF 大文件下载默认用 hf-mirror 的 hfd（scripts/download_hf.sh），小文件单线即可

# HuggingFace 镜像端点（国内默认 hf-mirror）
# HF_ENDPOINT=https://hf-mirror.com

# GitHub 访问代理：git clone / raw 下载默认经此代理
# GH_PROXY=https://gh-proxy.com

# PyPI / uv 包镜像（默认阿里云，可改为清华 https://pypi.tuna.tsinghua.edu.cn/simple 等）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ===== 行为选项 =====

# 是否自动通过各阶段审批: true | false
# true 时工作流全自动运行，不会在每个阶段暂停等待确认
AUTO_APPROVE=false

# 运行模式: full | dry-run
# full    — 完整执行所有阶段
# dry-run — 仅预览：扫描模型、检查环境、输出计划，不下载大文件也不编译
MODE=full
